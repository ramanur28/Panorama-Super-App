# =========================================================================
# STAGE 1: BUILD REACT SPA WITH NODE 20 ALPINE
# =========================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code and build production assets
COPY . .
RUN npm run build

# =========================================================================
# STAGE 2: PRODUCTION RUNNER WITH NGINX ALPINE (~28MB)
# Reverse proxy ditangani secara eksternal oleh Caddy di VPS
# =========================================================================
FROM nginx:alpine AS runner

# Bersihkan file default dan set routing SPA minimal secara inline
RUN rm -rf /usr/share/nginx/html/* && \
    printf 'server {\n    listen 80;\n    root /usr/share/nginx/html;\n    index index.html;\n    location / {\n        try_files $uri $uri/ /index.html;\n    }\n}\n' > /etc/nginx/conf.d/default.conf

# Copy built assets dari builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
