# =========================================================================
# PANORAMA SUPER APP - PRODUCTION VPS ENVIRONMENT CONFIGURATION
# Diselaraskan untuk VPS dengan reverse proxy Caddy yang telah berjalan
# Salin file ini menjadi .env pada server VPS Anda atau mesin lokal:
# cp .env.production.example .env
# =========================================================================

# -------------------------------------------------------------------------
# DOCKER REGISTRY CONFIGURATION
# -------------------------------------------------------------------------
# Gunakan 'docker.io' untuk Docker Hub, atau 'ghcr.io' untuk GitHub Container Registry
DOCKER_REGISTRY=docker.io

# Akun / Namespace / Username Docker Registry Anda (contoh: retdev)
REGISTRY_USER=retdev

# Versi Tag image (bisa 'latest' atau nomor rilis seperti 'v1.0.0' / timestamp)
IMAGE_TAG=latest

# -------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL 8.0)
# -------------------------------------------------------------------------
MYSQL_DATABASE=panorama_tour_db
MYSQL_USER=panorama_user
MYSQL_PASSWORD=ganti_dengan_password_user_sangat_aman_2026
MYSQL_ROOT_PASSWORD=ganti_dengan_password_root_sangat_aman_2026

# -------------------------------------------------------------------------
# LOCALHOST PORT BINDING (Di-proxy oleh Caddy di host VPS)
# -------------------------------------------------------------------------
# Port internal Web Frontend (Caddy akan mem-proxy trafik web ke port ini)
FRONTEND_PORT=3000

# Port internal REST API (Caddy akan mem-proxy path /api/* ke port ini)
BACKEND_PORT=4000

# -------------------------------------------------------------------------
# VPS CONNECTION (Digunakan oleh skrip scripts/deploy.sh & deploy.ps1)
# -------------------------------------------------------------------------
VPS_HOST=123.45.67.89
VPS_USER=root
VPS_SSH_PORT=22
# Opsional: path ke ssh private key jika tidak menggunakan ~/.ssh/id_rsa default
VPS_SSH_KEY=~/.ssh/id_rsa
# Path direktori kerja deployment di server VPS
VPS_DEPLOY_PATH=/opt/panorama-app

# -------------------------------------------------------------------------
# CONTOH KONFIGURASI CADDY (Tambahkan ke /etc/caddy/Caddyfile di VPS Anda):
# -------------------------------------------------------------------------
# panorama.domainanda.com {
#     # Reverse proxy API ke Node.js backend
#     handle /api/* {
#         reverse_proxy 127.0.0.1:4000
#     }
#
#     # Reverse proxy Web SPA ke frontend container
#     handle {
#         reverse_proxy 127.0.0.1:3000
#     }
# }
